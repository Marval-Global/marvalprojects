#!/bin/sh

set -e
set -u

# Check if bundle is installed; if not, install it and run full setup
if ! bundle check > /dev/null 2>&1; then
  echo "Installing gems..."
  bundle install --jobs $(nproc)

  # Run database setup since volumes were likely cleared
  echo "Running database setup..."
  bundle exec rake db:create db:migrate db:seed
fi

rm -rf "${OPENPROJECT_STORAGE_TMP__PATH:-tmp}/*"
exec bundle exec rails server -u puma -b 0.0.0.0
